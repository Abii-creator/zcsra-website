---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";

const images = Array.from({ length: 13 }, (_, index) => ({
  src: `/images/gallery/${index + 1}.jpg`,
  title: `Picha ya Tukio ${index + 1}`
}));
---

<BaseLayout title="Maktaba ya Picha - ZCSRA" lang="sw">

  <TopBar lang="sw" />
  <Header lang="sw" />
  <Breadcrumbs lang="sw" current="Maktaba ya Picha" />

  <main class="gallery-page">

    <section class="gallery-hero">
      <div class="container">
        <span class="gallery-kicker">PICHA ZA TAASISI</span>

        <h1>Maktaba ya Picha</h1>

        <p>
          Tazama picha mbalimbali za shughuli, matukio, mikutano na huduma za
          Wakala wa Usajili wa Matukio ya Kijamii Zanzibar.
        </p>
      </div>
    </section>

    <section class="gallery-section">
      <div class="container">

        <div class="gallery-grid">
          {images.map((image) => (
            <button
              class="gallery-card"
              type="button"
              data-src={image.src}
              data-title={image.title}
            >
              <img src={image.src} alt={image.title} />

              <div class="gallery-caption">
                {image.title}
              </div>
            </button>
          ))}
        </div>

      </div>
    </section>

  </main>

  <!-- =====================================================
       LIGHTBOX
  ====================================================== -->
  <div class="lightbox" id="galleryLightbox" aria-hidden="true">

    <button
      class="lightbox-close"
      id="lightboxClose"
      type="button"
      aria-label="Funga picha"
    >
      ×
    </button>

    <div class="lightbox-content">
      <img id="lightboxImage" src="" alt="" />
      <div class="lightbox-title" id="lightboxTitle"></div>
    </div>

  </div>

  <Footer lang="sw" />
  <WhatsAppFloat lang="sw" />

</BaseLayout>

<script lang="ts">
document.addEventListener("DOMContentLoaded", () => {
  const cards =
    document.querySelectorAll<HTMLButtonElement>(".gallery-card");

  const lightbox =
    document.getElementById("galleryLightbox");

  const lightboxImage =
    document.getElementById("lightboxImage");

  const lightboxTitle =
    document.getElementById("lightboxTitle");

  const closeBtn =
    document.getElementById("lightboxClose");

  function closeLightbox() {
    lightbox?.classList.remove("active");
    lightbox?.setAttribute("aria-hidden", "true");

    if (lightboxImage instanceof HTMLImageElement) {
      lightboxImage.src = "";
      lightboxImage.alt = "";
    }

    if (lightboxTitle) {
      lightboxTitle.textContent = "";
    }

    document.body.classList.remove("no-scroll");
  }

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      const src = card.getAttribute("data-src") || "";
      const title = card.getAttribute("data-title") || "";

      if (lightboxImage instanceof HTMLImageElement) {
        lightboxImage.src = src;
        lightboxImage.alt = title;
      }

      if (lightboxTitle) {
        lightboxTitle.textContent = title;
      }

      lightbox?.classList.add("active");
      lightbox?.setAttribute("aria-hidden", "false");
      document.body.classList.add("no-scroll");
    });
  });

  closeBtn?.addEventListener("click", closeLightbox);

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) {
      closeLightbox();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeLightbox();
    }
  });
});
</script>

<style>
.gallery-page{
  background:#f3f4f6;
}

.gallery-hero{
  padding:28px 0 20px;
  background:#ffffff;
}

.gallery-kicker{
  color:#f6a313;
  font-size:12px;
  font-weight:900;
  letter-spacing:2px;
}

.gallery-hero h1{
  margin:10px 0;
  color:#082b55;
  font-size:42px;
  font-weight:900;
}

.gallery-hero p{
  margin:0;
  max-width:800px;
  color:#5f6b7a;
  font-size:16px;
  line-height:1.8;
}

.gallery-section{
  padding:28px 0 50px;
}

.gallery-grid{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:22px;
}

.gallery-card{
  display:block;
  width:100%;
  padding:0;
  text-align:left;
  background:#ffffff;
  border-radius:20px;
  overflow:hidden;
  border:1px solid #e8edf3;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  cursor:pointer;
}

.gallery-card:hover{
  transform:translateY(-4px);
  transition:.25s ease;
}

.gallery-card img{
  width:100%;
  height:260px;
  display:block;
  object-fit:cover;
}

.gallery-caption{
  padding:14px 16px;
  color:#082b55;
  font-size:15px;
  font-weight:900;
}

/* =====================================================
   LIGHTBOX
===================================================== */
.lightbox{
  position:fixed;
  inset:0;
  z-index:9999;
  display:none;
  align-items:center;
  justify-content:center;
  padding:30px;
  background:rgba(0,0,0,.86);
}

.lightbox.active{
  display:flex;
}

.lightbox-content{
  max-width:1100px;
  width:100%;
}

.lightbox-content img{
  width:100%;
  max-height:82vh;
  object-fit:contain;
  display:block;
  border-radius:18px;
  background:#000000;
}

.lightbox-title{
  margin-top:12px;
  color:#ffffff;
  font-size:16px;
  font-weight:800;
  text-align:center;
}

.lightbox-close{
  position:absolute;
  top:22px;
  right:26px;
  width:46px;
  height:46px;
  border:none;
  border-radius:50%;
  background:#ffffff;
  color:#082b55;
  font-size:30px;
  line-height:1;
  cursor:pointer;
  font-weight:900;
}

.lightbox-close:hover{
  background:#f6a313;
  color:#ffffff;
}

:global(body.no-scroll){
  overflow:hidden;
}

@media (max-width:900px){
  .gallery-grid{
    grid-template-columns:repeat(2, 1fr);
  }
}

@media (max-width:640px){
  .gallery-hero h1{
    font-size:32px;
  }

  .gallery-grid{
    grid-template-columns:1fr;
  }

  .gallery-card img{
    height:230px;
  }

  .lightbox{
    padding:18px;
  }

  .lightbox-close{
    top:14px;
    right:14px;
  }
}
</style>