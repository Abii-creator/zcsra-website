---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
---

<BaseLayout title="Mawasiliano - ZCSRA" lang="sw">
  <TopBar lang="sw" />
  <Header lang="sw" />
  <Breadcrumbs lang="sw" current="Mawasiliano" />

  <section style="padding:10px 0 0 0;">
    <div class="container">
      <div class="card" style="background:#ffffff;border-radius:24px;padding:34px;">
        <div style="font-size:14px;font-weight:800;color:#f6a313;letter-spacing:2px;margin-bottom:10px;">
          MAWASILIANO
        </div>

        <h1 style="margin:0 0 20px 0;font-size:42px;color:#1e3a5f;font-weight:900;">
          Wasiliana Nasi
        </h1>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
          <div class="card" style="background:#f8f9fb;padding:24px;border-radius:18px;">
            <h3 style="margin:0 0 14px 0;color:#1e3a5f;">Taarifa za Mawasiliano</h3>
            <div style="display:grid;gap:12px;color:#5f6b7a;line-height:1.8;">
              <div><strong>Simu:</strong> 0772400597</div>
              <div><strong>Email:</strong> info@zcsra.go.tz</div>
              <div><strong>S.L.P:</strong> 264</div>
              <div><strong>Anwani:</strong> Flamingo, Migombani, Zanzibar</div>
              <div><strong>Saa za kazi:</strong> Jumatatu mpaka Ijumaa, 08:00 asubuhi hadi 3:30 mchana</div>
            </div>
          </div>

          <div class="card" style="background:#f8f9fb;padding:24px;border-radius:18px;">
            <h3 style="margin:0 0 14px 0;color:#1e3a5f;">Tuma Ujumbe</h3>

            <form style="display:grid;gap:14px;">
              <input type="text" placeholder="Jina lako" style="padding:14px 16px;border:1px solid #dfe3ea;border-radius:12px;font-size:15px;" />
              <input type="email" placeholder="Email yako" style="padding:14px 16px;border:1px solid #dfe3ea;border-radius:12px;font-size:15px;" />
              <textarea placeholder="Ujumbe wako" rows="6" style="padding:14px 16px;border:1px solid #dfe3ea;border-radius:12px;font-size:15px;resize:vertical;"></textarea>

              <button type="button" style="display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;border-radius:12px;font-weight:800;background:#f6a313;color:#fff;border:none;width:max-content;">
                Tuma Ujumbe
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer lang="sw" />
  <WhatsAppFloat lang="sw" />
</BaseLayout>