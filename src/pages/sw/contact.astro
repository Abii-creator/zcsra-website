---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
---

<BaseLayout title="Mawasiliano - ZCSRA" lang="sw">

  <TopBar lang="sw" />
  <Header lang="sw" />
  <Breadcrumbs lang="sw" current="Mawasiliano" />

  <main class="contact-page">

    <section class="contact-hero">
      <div class="container">

        <div class="contact-hero-card">

          <span class="contact-kicker">
            MAWASILIANO
          </span>

          <h1>
            Wasiliana Nasi
          </h1>

          <p>
            Kwa maulizo kuhusu huduma za usajili, nyaraka, matangazo au taarifa nyingine za taasisi, unaweza kuwasiliana nasi kupitia njia zifuatazo.
          </p>

        </div>

      </div>
    </section>

    <section class="contact-section">
      <div class="container">

        <div class="contact-grid">

          <!-- =====================================================
               CONTACT DETAILS
          ====================================================== -->
          <div class="contact-card">

            <h2>
              Taarifa za Mawasiliano
            </h2>

            <div class="contact-list">

              <div class="contact-item">
                <span>☎</span>
                <div>
                  <strong>Simu</strong>
                  <p>0772400597</p>
                </div>
              </div>

              <div class="contact-item">
                <span>✉</span>
                <div>
                  <strong>Email</strong>
                  <p>info@zcsra.go.tz</p>
                </div>
              </div>

              <div class="contact-item">
                <span>📮</span>
                <div>
                  <strong>S.L.P</strong>
                  <p>264</p>
                </div>
              </div>

              <div class="contact-item">
                <span>📍</span>
                <div>
                  <strong>Anwani</strong>
                  <p>Flamingo, Migombani, Zanzibar</p>
                </div>
              </div>

              <div class="contact-item">
                <span>🕒</span>
                <div>
                  <strong>Saa za kazi</strong>
                  <p>Jumatatu mpaka Ijumaa, 08:00 asubuhi hadi 3:30 mchana</p>
                </div>
              </div>

            </div>

          </div>

          <!-- =====================================================
               CONTACT FORM
          ====================================================== -->
          <div class="contact-card">

            <h2>
              Tuma Ujumbe
            </h2>

            <form class="contact-form">

              <input
                type="text"
                placeholder="Jina lako"
              />

              <input
                type="email"
                placeholder="Email yako"
              />

              <input
                type="text"
                placeholder="Kichwa cha ujumbe"
              />

              <textarea
                placeholder="Ujumbe wako"
                rows="6"
              ></textarea>

              <button type="button">
                Tuma Ujumbe
              </button>

            </form>

          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer lang="sw" />
  <WhatsAppFloat lang="sw" />

</BaseLayout>

<style>
.contact-page{
  background:#f3f4f6;
}

.contact-hero{
  padding:18px 0 28px;
}

.contact-hero-card{
  background:#ffffff;
  border-radius:24px;
  padding:34px;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
}

.contact-kicker{
  display:inline-flex;
  margin-bottom:10px;
  font-size:13px;
  font-weight:900;
  color:#f6a313;
  letter-spacing:2px;
}

.contact-hero-card h1{
  margin:0 0 16px;
  font-size:42px;
  line-height:1.1;
  color:#082b55;
  font-weight:900;
}

.contact-hero-card p{
  margin:0;
  max-width:860px;
  color:#5f6b7a;
  font-size:16px;
  line-height:1.9;
}

.contact-section{
  padding:0 0 44px;
}

.contact-grid{
  display:grid;
  grid-template-columns:.9fr 1.1fr;
  gap:22px;
  align-items:start;
}

.contact-card{
  background:#ffffff;
  border-radius:24px;
  padding:28px;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
}

.contact-card h2{
  margin:0 0 20px;
  color:#082b55;
  font-size:26px;
  font-weight:900;
}

.contact-list{
  display:grid;
  gap:14px;
}

.contact-item{
  display:flex;
  gap:14px;
  align-items:flex-start;
  background:#f8f9fb;
  border-radius:16px;
  padding:15px;
  border:1px solid #e8edf3;
}

.contact-item span{
  width:38px;
  height:38px;
  border-radius:12px;
  background:#f6a313;
  color:#ffffff;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
}

.contact-item strong{
  display:block;
  color:#082b55;
  font-size:14px;
  font-weight:900;
  margin-bottom:3px;
}

.contact-item p{
  margin:0;
  color:#5f6b7a;
  font-size:14px;
  line-height:1.6;
}

.contact-form{
  display:grid;
  gap:14px;
}

.contact-form input,
.contact-form textarea{
  width:100%;
  border:1px solid #dfe3ea;
  border-radius:14px;
  padding:14px 16px;
  font-size:15px;
  color:#082b55;
  background:#ffffff;
  outline:none;
}

.contact-form input:focus,
.contact-form textarea:focus{
  border-color:#f6a313;
  box-shadow:0 0 0 3px rgba(246,163,19,.14);
}

.contact-form textarea{
  resize:vertical;
}

.contact-form button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:max-content;
  padding:12px 22px;
  border-radius:999px;
  font-weight:900;
  background:#f6a313;
  color:#ffffff;
  border:none;
  cursor:pointer;
}

.contact-form button:hover{
  background:#e3950f;
}

@media (max-width:900px){

  .contact-grid{
    grid-template-columns:1fr;
  }

  .contact-hero-card h1{
    font-size:32px;
  }

}

@media (max-width:640px){

  .contact-hero-card,
  .contact-card{
    padding:24px 20px;
  }

  .contact-form button{
    width:100%;
  }

}
</style>