---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";

const services = [
  {
    icon: "👶",
    title: "Usajili wa Kuzaliwa",
    text: "Huduma ya usajili wa watoto wachanga na upatikanaji wa vyeti vya kuzaliwa kwa mujibu wa sheria na taratibu.",
    tag: "Huduma ya msingi"
  },
  {
    icon: "🕊️",
    title: "Usajili wa Vifo",
    text: "Kurekodi matukio ya vifo na kusaidia familia kupata nyaraka rasmi zinazohitajika.",
    tag: "Nyaraka rasmi"
  },
  {
    icon: "💍",
    title: "Usajili wa Ndoa",
    text: "Usajili wa ndoa na utoaji wa vyeti vya ndoa kwa mujibu wa sheria husika.",
    tag: "Usajili wa familia"
  },
  {
    icon: "📄",
    title: "Vyeti na Nyaraka",
    text: "Uombaji wa nakala za vyeti, marekebisho ya taarifa na huduma nyingine za nyaraka rasmi.",
    tag: "Vyeti"
  }
];

const steps = [
  "Chagua huduma unayohitaji.",
  "Andaa taarifa na nyaraka zinazohitajika.",
  "Wasilisha maombi kupitia ofisi husika au mfumo uliopo.",
  "Fuatilia maombi na pata taarifa ya hatua inayofuata."
];
---

<BaseLayout title="Huduma - ZCSRA" lang="sw">

  <TopBar lang="sw" />
  <Header lang="sw" />
  <Breadcrumbs lang="sw" current="Huduma" />

  <main class="services-page">

    <section class="services-hero">
      <div class="container">

        <div class="services-card">

          <span class="services-kicker">
            HUDUMA ZETU
          </span>

          <h1>
            Huduma Zinazopatikana
          </h1>

          <p>
            Hapa utapata muhtasari wa huduma kuu zinazotolewa na ZCSRA kwa wananchi na diaspora, ikiwemo usajili wa matukio muhimu ya kijamii na upatikanaji wa nyaraka rasmi.
          </p>

        </div>

      </div>
    </section>

    <section class="services-list">
      <div class="container">

        <div class="services-grid">

          {services.map((service) => (
            <article class="service-card">

              <div class="service-icon">
                {service.icon}
              </div>

              <span class="service-tag">
                {service.tag}
              </span>

              <h2>
                {service.title}
              </h2>

              <p>
                {service.text}
              </p>

            </article>
          ))}

        </div>

      </div>
    </section>

    <section class="service-steps">
      <div class="container">

        <div class="steps-card">

          <div class="steps-intro">
            <span class="services-kicker">
              MCHAKATO
            </span>

            <h2>
              Hatua za Kupata Huduma
            </h2>

            <p>
              Fuata hatua hizi kwa urahisi ili kupata huduma husika kwa mujibu wa taratibu za taasisi.
            </p>
          </div>

          <div class="steps-list">
            {steps.map((step, index) => (
              <div class="step-item">
                <span>{index + 1}</span>
                <p>{step}</p>
              </div>
            ))}
          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer lang="sw" />
  <WhatsAppFloat lang="sw" />

</BaseLayout>

<style>
.services-page{
  background:#f3f4f6;
}

.services-hero{
  padding:18px 0 28px;
}

.services-card,
.steps-card{
  background:#ffffff;
  border-radius:24px;
  padding:34px;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
}

.services-kicker{
  display:inline-flex;
  margin-bottom:10px;
  font-size:13px;
  font-weight:900;
  color:#f6a313;
  letter-spacing:2px;
}

.services-card h1{
  margin:0 0 16px;
  font-size:42px;
  line-height:1.1;
  color:#082b55;
  font-weight:900;
}

.services-card p{
  margin:0;
  max-width:860px;
  color:#5f6b7a;
  font-size:16px;
  line-height:1.9;
}

.services-list{
  padding:0 0 34px;
}

.services-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
}

.service-card{
  background:#ffffff;
  border-radius:22px;
  padding:26px;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
  position:relative;
  overflow:hidden;
}

.service-card::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:5px;
  background:#f6a313;
}

.service-icon{
  width:58px;
  height:58px;
  border-radius:16px;
  background:rgba(246,163,19,.14);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:30px;
  margin-bottom:14px;
}

.service-tag{
  display:inline-flex;
  margin-bottom:10px;
  padding:6px 11px;
  border-radius:999px;
  background:rgba(8,43,85,.08);
  color:#082b55;
  font-size:12px;
  font-weight:900;
}

.service-card h2{
  margin:0 0 10px;
  color:#082b55;
  font-size:24px;
  font-weight:900;
}

.service-card p{
  margin:0;
  color:#5f6b7a;
  line-height:1.8;
  font-size:15px;
}

.service-steps{
  padding:0 0 44px;
}

.steps-card{
  display:grid;
  grid-template-columns:.9fr 1.1fr;
  gap:28px;
  align-items:start;
}

.steps-intro h2{
  margin:0 0 12px;
  color:#082b55;
  font-size:32px;
  font-weight:900;
  line-height:1.2;
}

.steps-intro p{
  margin:0;
  color:#5f6b7a;
  line-height:1.8;
}

.steps-list{
  display:grid;
  gap:12px;
}

.step-item{
  display:flex;
  align-items:flex-start;
  gap:14px;
  background:#f8f9fb;
  border-radius:16px;
  padding:15px;
  border:1px solid #e8edf3;
}

.step-item span{
  width:34px;
  height:34px;
  border-radius:12px;
  background:#082b55;
  color:#ffffff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:900;
  flex-shrink:0;
}

.step-item p{
  margin:0;
  color:#5f6b7a;
  line-height:1.7;
  font-size:14px;
}

@media (max-width:900px){

  .services-grid,
  .steps-card{
    grid-template-columns:1fr;
  }

  .services-card h1{
    font-size:32px;
  }

}

@media (max-width:640px){

  .services-card,
  .steps-card{
    padding:24px 20px;
  }

  .service-card{
    padding:22px;
  }

}
</style>