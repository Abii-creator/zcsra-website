---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
---

<BaseLayout title="Huduma" lang="sw">
  <TopBar lang="sw" />
  <Header lang="sw" />
  <Breadcrumbs lang="sw" current="Huduma" />

  <section style="padding:10px 0 0 0;">
    <div class="container">
      <div class="card" style="background:#ffffff;border-radius:24px;padding:34px;">
        <div style="max-width:860px;">
          <div style="font-size:14px;font-weight:800;color:#f6a313;letter-spacing:2px;margin-bottom:10px;">
            HUDUMA ZETU
          </div>

          <h1 style="margin:0 0 16px 0;font-size:42px;line-height:1.1;color:#1e3a5f;font-weight:900;">
            Huduma Zinazopatikana
          </h1>

          <p style="margin:0;color:#5f6b7a;font-size:17px;line-height:1.9;">
            Hapa utapata muhtasari wa huduma kuu zinazotolewa na taasisi kwa wananchi na diaspora.
          </p>
        </div>

        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:28px;">
          <div class="card" style="background:#f8f9fb;padding:24px;border-radius:18px;">
            <div style="font-size:34px;margin-bottom:10px;">👶</div>
            <h3 style="margin:0 0 10px 0;color:#1e3a5f;">Usajili wa Kuzaliwa</h3>
            <p style="margin:0;color:#5f6b7a;line-height:1.8;">
              Huduma ya usajili wa watoto wachanga na upatikanaji wa vyeti vya kuzaliwa kwa mujibu wa sheria na taratibu za nchi.
            </p>
          </div>

          <div class="card" style="background:#f8f9fb;padding:24px;border-radius:18px;">
            <div style="font-size:34px;margin-bottom:10px;">🕊️</div>
            <h3 style="margin:0 0 10px 0;color:#1e3a5f;">Usajili wa Vifo</h3>
            <p style="margin:0;color:#5f6b7a;line-height:1.8;">
              Huduma ya kurekodi matukio ya vifo na kusaidia upatikanaji wa nyaraka rasmi kwa familia na wadau.
            </p>
          </div>

          <div class="card" style="background:#f8f9fb;padding:24px;border-radius:18px;">
            <div style="font-size:34px;margin-bottom:10px;">💍</div>
            <h3 style="margin:0 0 10px 0;color:#1e3a5f;">Usajili wa Ndoa</h3>
            <p style="margin:0;color:#5f6b7a;line-height:1.8;">
              Huduma ya usajili wa ndoa na utoaji wa vyeti vya ndoa kwa mujibu wa sheria husika.
            </p>
          </div>

          <div class="card" style="background:#f8f9fb;padding:24px;border-radius:18px;">
            <div style="font-size:34px;margin-bottom:10px;">📄</div>
            <h3 style="margin:0 0 10px 0;color:#1e3a5f;">Vyeti na Nyaraka</h3>
            <p style="margin:0;color:#5f6b7a;line-height:1.8;">
              Uombaji wa nakala za vyeti, marekebisho ya taarifa, na huduma nyingine za nyaraka rasmi.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer lang="sw" />
  <WhatsAppFloat lang="sw" />
</BaseLayout>