---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";

const activities = [
  {
    title: "Mafunzo ya Mfumo wa Usajili",
    date: "10 Juni 2024",
    text: "Watumishi walipata mafunzo kuhusu matumizi ya mfumo mpya wa usajili wa matukio ya kijamii.",
    type: "Mafunzo"
  },
  {
    title: "Mkutano wa Ndani wa Taasisi",
    date: "28 Mei 2024",
    text: "Kikao cha ndani cha wafanyakazi kujadili maboresho ya utoaji wa huduma kwa wananchi.",
    type: "Mkutano"
  },
  {
    title: "Warsha ya Uboreshaji wa Huduma",
    date: "12 Mei 2024",
    text: "Warsha ya kujadili mbinu za kuongeza ufanisi, uwazi na ubora wa huduma za usajili.",
    type: "Warsha"
  }
];
---

<BaseLayout title="Shughuli za Watumishi - ZCSRA" lang="sw">

  <TopBar lang="sw" />
  <Header lang="sw" />
  <Breadcrumbs lang="sw" current="Shughuli za Watumishi" />

  <main class="staff-page">

    <section class="staff-hero">
      <div class="container">
        <div class="staff-hero-card">
          <span class="staff-kicker">SHUGHULI ZA WATUMISHI</span>

          <h1>Shughuli za Watumishi</h1>

          <p>
            Fuatilia shughuli za ndani, mafunzo, mikutano na warsha zinazolenga kuboresha ufanisi wa huduma za ZCSRA.
          </p>
        </div>
      </div>
    </section>

    <section class="staff-list-section">
      <div class="container">
        <div class="staff-grid">
          {activities.map((item) => (
            <article class="staff-card">
              <div class="staff-meta">
                <span class="staff-type">{item.type}</span>
                <span class="staff-date">{item.date}</span>
              </div>

              <h2>{item.title}</h2>
              <p>{item.text}</p>

              <a href="#" class="staff-btn">Soma Zaidi</a>
            </article>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer lang="sw" />
  <WhatsAppFloat lang="sw" />

</BaseLayout>

<style>
.staff-page{
  background:#f3f4f6;
}

.staff-hero{
  padding:18px 0 28px;
}

.staff-hero-card{
  background:#ffffff;
  border-radius:24px;
  padding:34px;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
}

.staff-kicker{
  display:inline-flex;
  margin-bottom:10px;
  font-size:13px;
  font-weight:900;
  color:#f6a313;
  letter-spacing:2px;
}

.staff-hero-card h1{
  margin:0 0 16px;
  font-size:42px;
  line-height:1.1;
  color:#082b55;
  font-weight:900;
}

.staff-hero-card p{
  margin:0;
  max-width:860px;
  color:#5f6b7a;
  font-size:16px;
  line-height:1.9;
}

.staff-list-section{
  padding:0 0 44px;
}

.staff-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:18px;
}

.staff-card{
  position:relative;
  background:#ffffff;
  border-radius:22px;
  padding:24px;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
  overflow:hidden;
}

.staff-card::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:5px;
  background:#2f6b3d;
}

.staff-meta{
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
  margin-bottom:14px;
}

.staff-type{
  display:inline-flex;
  padding:6px 11px;
  border-radius:999px;
  background:rgba(8,43,85,.08);
  color:#082b55;
  font-size:12px;
  font-weight:900;
}

.staff-date{
  color:#7a8594;
  font-size:13px;
  font-weight:800;
}

.staff-card h2{
  margin:0 0 10px;
  color:#082b55;
  font-size:23px;
  font-weight:900;
  line-height:1.3;
}

.staff-card p{
  margin:0 0 16px;
  color:#5f6b7a;
  line-height:1.8;
  font-size:15px;
}

.staff-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:10px 16px;
  border-radius:999px;
  background:#f6a313;
  color:#ffffff;
  font-size:13px;
  font-weight:900;
  text-decoration:none;
}

.staff-btn:hover{
  background:#e3950f;
}

@media (max-width:1000px){
  .staff-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}

@media (max-width:700px){
  .staff-hero-card{
    padding:24px 20px;
  }

  .staff-hero-card h1{
    font-size:32px;
  }

  .staff-grid{
    grid-template-columns:1fr;
  }

  .staff-card{
    padding:22px 20px;
  }
}
</style>