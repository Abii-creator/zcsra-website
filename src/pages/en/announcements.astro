---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
---

<BaseLayout title="Announcements" lang="en">
  <TopBar lang="en" />
  <Header lang="en" />
  <Breadcrumbs lang="en" current="Announcements" />

  <section style="padding:10px 0 0 0;">
    <div class="container">
      <div class="card" style="background:#ffffff;border-radius:24px;padding:34px;">

        <div style="font-size:14px;font-weight:800;color:#f6a313;letter-spacing:2px;margin-bottom:10px;">
          ANNOUNCEMENTS
        </div>

        <h1 style="margin:0 0 20px 0;font-size:42px;color:#1e3a5f;font-weight:900;">
          Institutional Announcements
        </h1>

        <div style="display:grid;grid-template-columns:1fr;gap:18px;">

          <div class="card" style="background:#f8f9fb;padding:22px;border-radius:18px;">
            <h3 style="margin:0 0 8px 0;color:#1e3a5f;">New Death Registration Guidelines</h3>
            <div style="font-size:13px;color:#8892a0;margin-bottom:10px;">22 February 2024</div>
            <p style="margin:0;color:#5f6b7a;line-height:1.8;">
              The institution has released new guidelines for death registration to improve service efficiency and documentation.
            </p>
          </div>

          <div class="card" style="background:#f8f9fb;padding:22px;border-radius:18px;">
            <h3 style="margin:0 0 8px 0;color:#1e3a5f;">Public Awareness Campaign</h3>
            <div style="font-size:13px;color:#8892a0;margin-bottom:10px;">24 January 2024</div>
            <p style="margin:0;color:#5f6b7a;line-height:1.8;">
              A new public awareness campaign on social event registration has been launched across Zanzibar.
            </p>
          </div>

          <div class="card" style="background:#f8f9fb;padding:22px;border-radius:18px;">
            <h3 style="margin:0 0 8px 0;color:#1e3a5f;">New Online Services</h3>
            <div style="font-size:13px;color:#8892a0;margin-bottom:10px;">19 January 2024</div>
            <p style="margin:0;color:#5f6b7a;line-height:1.8;">
              Citizens can now access some services online to simplify the process of obtaining official documents.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>

  <Footer lang="en" />
  <WhatsAppFloat lang="en" />
</BaseLayout>