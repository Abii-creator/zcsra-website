---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
---

<BaseLayout title="About Us - ZCSRA" lang="en">

  <TopBar lang="en" />
  <Header lang="en" />
  <Breadcrumbs lang="en" current="About Us" />

  <main class="about-page">

    <section class="about-hero">
      <div class="container">

        <div class="about-card">

          <div class="about-intro">

            <span class="about-kicker">
              ABOUT THE INSTITUTION
            </span>

            <h1>
              About the Zanzibar Civil Status Registration Agency
            </h1>

            <p>
              The agency was established to coordinate, manage and improve the registration of vital civil events for the people of Zanzibar and the diaspora.
            </p>

            <p>
              Through this website, citizens can access information, guidelines and essential services more easily. Our mission is to ensure that services are delivered transparently, efficiently and through modern systems.
            </p>

          </div>

          <div class="about-logo-box">
            <img
              src="/images/zcsra-logo.png"
              alt="ZCSRA Logo"
              class="about-logo"
            />

            <div class="about-logo-text">
              ZCSRA
            </div>

            <span>
              Zanzibar Civil Status Registration Agency
            </span>
          </div>

        </div>

      </div>
    </section>

    <section class="about-values">
      <div class="container">

        <div class="values-grid">

          <article class="value-card">
            <div class="value-icon gold">01</div>
            <h3>Vision</h3>
            <p>
              To be a modern and leading institution in civil status registration and citizen service delivery.
            </p>
          </article>

          <article class="value-card">
            <div class="value-icon green">02</div>
            <h3>Mission</h3>
            <p>
              To manage registration services efficiently, transparently and in ways that respond to the real needs of citizens.
            </p>
          </article>

          <article class="value-card">
            <div class="value-icon blue">03</div>
            <h3>Values</h3>
            <p>
              Integrity, accountability, quality service, cooperation and respect for the citizens we serve.
            </p>
          </article>

        </div>

      </div>
    </section>

  </main>

  <Footer lang="en" />
  <WhatsAppFloat lang="en" />

</BaseLayout>

<style>
.about-page{
  background:#f3f4f6;
}

.about-hero{
  padding:18px 0 32px;
}

.about-card{
  display:grid;
  grid-template-columns:minmax(0,1fr) 320px;
  gap:30px;
  align-items:center;
  background:#ffffff;
  border-radius:24px;
  padding:34px;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
}

.about-kicker{
  display:inline-flex;
  margin-bottom:10px;
  font-size:13px;
  font-weight:900;
  color:#f6a313;
  letter-spacing:2px;
}

.about-intro h1{
  margin:0 0 16px;
  font-size:42px;
  line-height:1.1;
  color:#082b55;
  font-weight:900;
}

.about-intro p{
  margin:0 0 16px;
  color:#5f6b7a;
  font-size:16px;
  line-height:1.9;
}

.about-logo-box{
  border-radius:22px;
  background:linear-gradient(180deg,#f8fafc,#ffffff);
  border:1px solid #e8edf3;
  padding:28px 22px;
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
}

.about-logo{
  width:150px;
  height:150px;
  object-fit:contain;
  margin-bottom:16px;
}

.about-logo-text{
  font-size:28px;
  font-weight:900;
  color:#082b55;
  line-height:1;
}

.about-logo-box span{
  margin-top:8px;
  font-size:13px;
  font-weight:800;
  color:#5f6b7a;
  line-height:1.5;
}

.about-values{
  padding:0 0 42px;
}

.values-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:18px;
}

.value-card{
  background:#ffffff;
  border-radius:22px;
  padding:24px 22px;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
}

.value-icon{
  width:48px;
  height:48px;
  border-radius:14px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#ffffff;
  font-size:14px;
  font-weight:900;
  margin-bottom:16px;
}

.value-icon.gold{
  background:#f6a313;
}

.value-icon.green{
  background:#2f6b3d;
}

.value-icon.blue{
  background:#082b55;
}

.value-card h3{
  margin:0 0 10px;
  color:#082b55;
  font-size:22px;
  font-weight:900;
}

.value-card p{
  margin:0;
  color:#5f6b7a;
  line-height:1.8;
  font-size:14px;
}

@media (max-width:900px){

  .about-card{
    grid-template-columns:1fr;
  }

  .values-grid{
    grid-template-columns:1fr;
  }

  .about-intro h1{
    font-size:32px;
  }

}

@media (max-width:640px){

  .about-card{
    padding:24px 20px;
  }

  .about-logo{
    width:120px;
    height:120px;
  }

}
</style>