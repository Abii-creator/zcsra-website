---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
---

<BaseLayout title="Contact - ZCSRA" lang="en">
  <TopBar lang="en" />
  <Header lang="en" />
  <Breadcrumbs lang="en" current="Contact" />

  <section style="padding:10px 0 0 0;">
    <div class="container">
      <div class="card" style="background:#ffffff;border-radius:24px;padding:34px;">
        <div style="font-size:14px;font-weight:800;color:#f6a313;letter-spacing:2px;margin-bottom:10px;">
          CONTACT
        </div>

        <h1 style="margin:0 0 20px 0;font-size:42px;color:#1e3a5f;font-weight:900;">
          Contact Us
        </h1>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
          <div class="card" style="background:#f8f9fb;padding:24px;border-radius:18px;">
            <h3 style="margin:0 0 14px 0;color:#1e3a5f;">Contact Information</h3>
            <div style="display:grid;gap:12px;color:#5f6b7a;line-height:1.8;">
              <div><strong>Phone:</strong> 0772400597</div>
              <div><strong>Email:</strong> info@zcsra.go.tz</div>
              <div><strong>P.O. Box:</strong> 264</div>
              <div><strong>Address:</strong> Flamingo, Migombani, Zanzibar</div>
              <div><strong>Working Hours:</strong> Monday to Friday, 08:00 AM to 3:30 PM</div>
            </div>
          </div>

          <div class="card" style="background:#f8f9fb;padding:24px;border-radius:18px;">
            <h3 style="margin:0 0 14px 0;color:#1e3a5f;">Send a Message</h3>

            <form style="display:grid;gap:14px;">
              <input type="text" placeholder="Your name" style="padding:14px 16px;border:1px solid #dfe3ea;border-radius:12px;font-size:15px;" />
              <input type="email" placeholder="Your email" style="padding:14px 16px;border:1px solid #dfe3ea;border-radius:12px;font-size:15px;" />
              <textarea placeholder="Your message" rows="6" style="padding:14px 16px;border:1px solid #dfe3ea;border-radius:12px;font-size:15px;resize:vertical;"></textarea>

              <button type="button" style="display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;border-radius:12px;font-weight:800;background:#f6a313;color:#fff;border:none;width:max-content;">
                Send Message
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer lang="en" />
  <WhatsAppFloat lang="en" />
</BaseLayout>