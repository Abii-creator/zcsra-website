---
const { lang = "sw" } = Astro.props;

const isSw = lang === "sw";

const phoneLabel = isSw ? "Simu" : "Phone";
const phoneNumber = "0772400597";
const phoneLink = "tel:+255772400597";

const email = "info@zcsra.go.tz";
const emailLink = "mailto:info@zcsra.go.tz";

const location = "Zanzibar, Tanzania";

const hours = isSw
  ? "Jumatatu - Ijumaa | 08:00 - 15:30"
  : "Mon - Fri | 08:00 - 15:30";
---

<div class="topbar">
  <div class="container topbar-inner">

    <!-- =====================================================
         LEFT CONTACT DETAILS
    ====================================================== -->
    <div class="topbar-left">

      <a href={phoneLink} class="topbar-item">
        <span class="topbar-icon">☎</span>
        <span>{phoneLabel}: {phoneNumber}</span>
      </a>

      <a href={emailLink} class="topbar-item">
        <span class="topbar-icon">✉</span>
        <span>{email}</span>
      </a>

    </div>

    <!-- =====================================================
         RIGHT OFFICE DETAILS
    ====================================================== -->
    <div class="topbar-right">

      <span class="topbar-item">
        <span class="topbar-icon">📍</span>
        <span>{location}</span>
      </span>

      <span class="topbar-item">
        <span class="topbar-icon">🕒</span>
        <span>{hours}</span>
      </span>

    </div>

  </div>
</div>

<style>

/* =====================================================
   TOP BAR
===================================================== */
.topbar{
  background:#082b55;
  color:#ffffff;
  font-size:13px;
  border-bottom:1px solid rgba(255,255,255,.08);
}

/* =====================================================
   TOP BAR INNER
===================================================== */
.topbar-inner{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  min-height:36px;
}

/* =====================================================
   LEFT AND RIGHT GROUPS
===================================================== */
.topbar-left,
.topbar-right{
  display:flex;
  align-items:center;
  gap:22px;
  min-width:0;
}

/* =====================================================
   TOP BAR ITEMS
===================================================== */
.topbar-item{
  display:inline-flex;
  align-items:center;
  gap:7px;
  color:#ffffff;
  text-decoration:none;
  font-weight:800;
  white-space:nowrap;
}

.topbar a:hover{
  color:#f6a313;
}

.topbar-icon{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  color:#f6a313;
  font-size:13px;
}

/* =====================================================
   RESPONSIVE DESIGN
===================================================== */
@media (max-width:900px){

  .topbar-inner{
    flex-direction:column;
    justify-content:center;
    gap:6px;
    padding:8px 0;
  }

  .topbar-left,
  .topbar-right{
    justify-content:center;
    flex-wrap:wrap;
    gap:12px;
  }

}

@media (max-width:520px){

  .topbar{
    font-size:12px;
  }

  .topbar-left,
  .topbar-right{
    flex-direction:column;
    gap:4px;
  }

  .topbar-item{
    white-space:normal;
    text-align:center;
  }

}
</style>