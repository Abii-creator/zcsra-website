---
const { lang = "sw" } = Astro.props;

const isSw = lang === "sw";

const title = isSw
  ? "Ujumbe kutoka kwa Mkurugenzi Mtendaji"
  : "Message from the Executive Director";

const name = "Mohammed Ame";

const position = isSw
  ? "Mkurugenzi Mtendaji"
  : "Executive Director";

const sub = isSw
  ? "UONGOZI WA TAASISI"
  : "INSTITUTIONAL LEADERSHIP";

const readMore = isSw
  ? "Soma Zaidi"
  : "Read More";

const paragraph = isSw
  ? "Karibu kwenye tovuti yetu rasmi. Tunajitahidi kutoa huduma bora za usajili wa matukio muhimu ya kijamii kwa uwazi, haraka, na ufanisi. Kupitia mfumo huu, wananchi na diaspora wataweza kupata taarifa, huduma, na mwongozo kwa urahisi zaidi."
  : "Welcome to our official website. We are committed to providing high-quality registration services for vital social events with transparency, speed, and efficiency. Through this platform, citizens and the diaspora can access information, services, and guidance more easily.";
---

<section class="md-section">
  <div class="md-card">

    <h2 class="md-heading">{title}</h2>

    <div class="md-grid">
      <div class="md-photo-col">
        <div class="md-photo-wrap">
          <img
            src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=700&q=80"
            alt="Executive Director"
            class="md-photo"
          />
        </div>

        <a href={isSw ? "/sw/about" : "/en/about"} class="md-btn">
          {readMore}
        </a>
      </div>

      <div class="md-content">
        <h3 class="md-name">{name}</h3>
        <div class="md-role">{position}</div>
        <div class="md-lead">{sub}</div>

        <div class="md-video-wrap">
          <img
            src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80"
            alt="Message preview"
            class="md-video"
          />
          <div class="md-play-holder">
            <div class="md-play">▶</div>
          </div>
        </div>

        <p class="md-text">{paragraph}</p>

        <div class="md-bands">
          <span class="band yellow"></span>
          <span class="band green"></span>
          <span class="band blue"></span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
.md-section{
  width:100%;
  min-width:0;
  padding:0;
  margin:0;
}

.md-card{
  background:#ffffff;
  border-radius:22px;
  padding:22px;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  overflow:hidden;
  width:100%;
  min-width:0;
}

.md-heading{
  margin:0 0 18px 0;
  font-size:22px;
  font-weight:900;
  color:#1e3a5f;
  line-height:1.2;
}

.md-grid{
  display:grid;
  grid-template-columns:160px minmax(0,1fr);
  gap:20px;
  align-items:start;
  min-width:0;
}

.md-photo-col{
  min-width:0;
}

.md-photo-wrap{
  border-radius:16px;
  overflow:hidden;
  background:#eef1f4;
}

.md-photo{
  width:100%;
  height:260px;
  object-fit:cover;
  display:block;
}

.md-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  margin-top:14px;
  padding:10px 16px;
  border-radius:10px;
  background:#f6a313;
  color:#ffffff;
  font-size:14px;
  font-weight:800;
  text-decoration:none;
}

.md-content{
  min-width:0;
}

.md-name{
  margin:0 0 8px 0;
  font-size:30px;
  font-weight:900;
  color:#1e3a5f;
  line-height:1.05;
  overflow-wrap:anywhere;
}

.md-role{
  color:#f6a313;
  font-size:18px;
  font-weight:900;
  margin-bottom:6px;
}

.md-lead{
  font-size:13px;
  color:#6c7a89;
  font-weight:700;
  margin-bottom:14px;
}

.md-video-wrap{
  position:relative;
  border-radius:18px;
  overflow:hidden;
  margin-bottom:16px;
  background:#eef1f4;
}

.md-video{
  width:100%;
  height:260px;
  object-fit:cover;
  display:block;
}

.md-play-holder{
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
}

.md-play{
  width:78px;
  height:78px;
  border-radius:999px;
  background:#ff3131;
  color:#ffffff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:34px;
  box-shadow:0 12px 24px rgba(0,0,0,.22);
}

.md-text{
  margin:0;
  font-size:14px;
  line-height:1.7;
  color:#5f6b7a;
}

.md-bands{
  margin-top:14px;
  overflow:hidden;
}

.band{
  display:block;
  height:8px;
  border-radius:999px;
  margin-bottom:8px;
  transform:rotate(-4deg);
  transform-origin:left center;
}

.yellow{
  background:#f4c542;
}

.green{
  background:#2f7a45;
}

.blue{
  background:#2f7dbd;
}

@media (max-width:900px){
  .md-grid{
    grid-template-columns:1fr;
  }

  .md-photo{
    height:230px;
  }

  .md-video{
    height:220px;
  }
}

@media (max-width:640px){
  .md-card{
    padding:18px;
  }

  .md-heading{
    font-size:20px;
  }

  .md-name{
    font-size:26px;
  }

  .md-play{
    width:66px;
    height:66px;
    font-size:28px;
  }
}
</style>