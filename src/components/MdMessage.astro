---
const { lang = "sw" } = Astro.props;

const isSw = lang === "sw";

const title = isSw
  ? "Mkurugenzi Mtendaji"
  : "Executive Director";

const name = "Mohammed Ame";

const position = isSw
  ? "Mkurugenzi Mtendaji"
  : "Executive Director";

const sub = isSw
  ? "UONGOZI WA TAASISI"
  : "INSTITUTIONAL LEADERSHIP";

const aboutLink = isSw ? "/sw/about/" : "/en/about/";

const paragraph = isSw
  ? "Karibu kwenye tovuti yetu rasmi. Tunajitahidi kutoa huduma bora za usajili wa matukio muhimu ya kijamii kwa uwazi, haraka na ufanisi."
  : "Welcome to our official website. We are committed to providing high-quality registration services for vital civil events with transparency, speed and efficiency.";
---

<section class="md-section">

  <div class="md-card">

    <!-- =====================================================
         SECTION HEADER
    ====================================================== -->
    <div class="md-section-head">

      <span class="md-kicker">
        {sub}
      </span>

      <h2 class="md-heading">
        {title}
      </h2>

    </div>

    <!-- =====================================================
         MD CONTENT GRID
         Photo and video must start and end on the same line
    ====================================================== -->
    <div class="md-grid">

      <!-- =====================================================
           PHOTO COLUMN
      ====================================================== -->
      <div class="md-photo-col">

        <div class="md-media-box">
          <img
            src="/images/md-photo.jpg"
            alt={name}
            class="md-photo"
          />
        </div>

        <div class="md-info">
          <a href={aboutLink} class="md-name-link">
            <h3 class="md-name">
              {name}
            </h3>
          </a>

          <div class="md-role">
            {position}
          </div>
        </div>

      </div>

      <!-- =====================================================
           VIDEO COLUMN
      ====================================================== -->
      <div class="md-video-col">

        <div class="md-video-wrap">

          <img
            src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80"
            alt="Message Preview"
            class="md-video"
          />

          <button
            class="md-play"
            type="button"
            aria-label="Play video"
          >
            ▶
          </button>

        </div>

        <p class="md-text">
          {paragraph}
        </p>

      </div>

    </div>

  </div>

</section>

<style>
.md-section{
  width:100%;
  min-width:0;
}

.md-card{
  position:relative;
  background:#ffffff;
  border-radius:24px;
  padding:22px;
  border:1px solid #e8edf3;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  overflow:hidden;
  min-width:0;
  height:100%;
}

.md-card::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  bottom:0;
  width:6px;
  background:linear-gradient(180deg,#f6a313,#2f6b3d,#082b55);
}

.md-section-head{
  margin-bottom:18px;
}

.md-kicker{
  display:inline-block;
  color:#f6a313;
  font-size:11px;
  font-weight:900;
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:6px;
}

.md-heading{
  margin:0;
  color:#082b55;
  font-size:24px;
  font-weight:900;
  line-height:1.2;
}

.md-grid{
  --media-height:380px;

  display:grid;
  grid-template-columns:300px minmax(0,1fr);
  gap:28px;
  align-items:start;
}

.md-photo-col,
.md-video-col{
  min-width:0;
}

.md-media-box,
.md-video-wrap{
  height:var(--media-height);
  border-radius:18px;
  overflow:hidden;
  border:1px solid #e8edf3;
  background:#eef1f4;
}

.md-photo,
.md-video{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.md-video-wrap{
  position:relative;
  width:100%;
  max-width:100%;
}

.md-play{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%, -50%);
  width:54px;
  height:54px;
  border:none;
  border-radius:50%;
  background:#d92525;
  color:#ffffff;
  font-size:19px;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow:0 10px 20px rgba(0,0,0,.20);
}

.md-info,
.md-text{
  margin-top:14px;
}

.md-name-link{
  display:block;
  text-decoration:none;
}

.md-name{
  margin:0;
  color:#082b55;
  font-size:20px;
  font-weight:900;
  line-height:1.2;
}

.md-name-link:hover .md-name{
  color:#f6a313;
  transition:.25s ease;
  cursor:pointer;
}

.md-role{
  color:#f6a313;
  font-size:14px;
  font-weight:900;
  margin-top:4px;
}

.md-text{
  margin-bottom:0;
  color:#5f6b7a;
  font-size:15px;
  line-height:1.75;
  max-width:100%;
}

@media (max-width:900px){

  .md-grid{
    grid-template-columns:1fr;
    --media-height:280px;
  }

}

@media (max-width:640px){

  .md-card{
    padding:18px;
  }

  .md-heading{
    font-size:21px;
  }

  .md-name{
    font-size:20px;
  }

  .md-grid{
    --media-height:240px;
  }

}
</style>