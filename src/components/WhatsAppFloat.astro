---
const { lang = "sw" } = Astro.props;

const phoneNumber = "255772400597";

const label =
  lang === "sw"
    ? "Ongea Nasi"
    : "Chat With Us";

const text =
  lang === "sw"
    ? "Habari, naomba msaada kuhusu huduma za ZCSRA."
    : "Hello, I need assistance regarding ZCSRA services.";

const href = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(text)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-float"
  aria-label="WhatsApp"
>

  <span class="wa-icon">
    💬
  </span>

  <span class="wa-label">
    {label}
  </span>

</a>

<style>

/* =====================================================
   WHATSAPP FLOAT BUTTON
===================================================== */
.wa-float{
  position:fixed;
  right:22px;
  bottom:22px;
  z-index:9999;

  display:flex;
  align-items:center;
  gap:10px;

  background:#25D366;
  color:#ffffff;

  padding:14px 18px;
  border-radius:999px;

  text-decoration:none;
  font-weight:800;
  font-size:14px;

  box-shadow:
    0 12px 28px rgba(0,0,0,.18);

  transition:
    transform .25s ease,
    box-shadow .25s ease;

  animation:
    waPulse 2.2s infinite;
}

.wa-float:hover{
  transform:translateY(-3px);
  box-shadow:
    0 16px 32px rgba(0,0,0,.22);
}

/* =====================================================
   ICON
===================================================== */
.wa-icon{
  font-size:22px;
  line-height:1;
}

/* =====================================================
   PULSE ANIMATION
===================================================== */
@keyframes waPulse{

  0%{
    box-shadow:
      0 0 0 0 rgba(37,211,102,.45);
  }

  70%{
    box-shadow:
      0 0 0 14px rgba(37,211,102,0);
  }

  100%{
    box-shadow:
      0 0 0 0 rgba(37,211,102,0);
  }

}

/* =====================================================
   MOBILE
===================================================== */
@media (max-width:640px){

  .wa-float{
    right:14px;
    bottom:14px;
    padding:12px 15px;
  }

  .wa-label{
    display:none;
  }

  .wa-icon{
    font-size:24px;
  }

}

</style>