---
const { lang = "sw" } = Astro.props;

const isSw = lang === "sw";

const title = isSw ? "Shughuli za Wafanyakazi" : "Staff Activities";
const subtitle = isSw
  ? "Fuatilia shughuli, mafunzo na kazi za ndani zinazolenga kuboresha utoaji wa huduma kwa wananchi."
  : "Follow internal activities, training and institutional work aimed at improving public service delivery.";

const viewAll = isSw ? "Tazama Zote" : "View All";
const listHref = isSw ? "/sw/staff-activities/" : "/en/staff-activities/";

const items = isSw
  ? [
      {
        title: "Mafunzo ya Mfumo wa Usajili",
        text: "Watumishi walipata mafunzo kuhusu matumizi ya mfumo mpya wa usajili.",
        img: "https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80"
      },
      {
        title: "Mkutano wa Ndani wa Taasisi",
        text: "Kikao cha ndani cha wafanyakazi kujadili maendeleo ya huduma kwa wananchi.",
        img: "https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1200&q=80"
      },
      {
        title: "Warsha ya Uboreshaji wa Huduma",
        text: "Warsha ya kujadili mbinu mpya za kuboresha utoaji wa huduma.",
        img: "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80"
      }
    ]
  : [
      {
        title: "Registration System Training",
        text: "Staff received training on the use of the new civil registration system.",
        img: "https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80"
      },
      {
        title: "Internal Institutional Meeting",
        text: "An internal meeting was held to discuss improvements in service delivery.",
        img: "https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1200&q=80"
      },
      {
        title: "Service Improvement Workshop",
        text: "Workshop focused on strategies to improve service delivery to citizens.",
        img: "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80"
      }
    ];
---

<section class="staff-section">
  <div class="container">

    <!-- =====================================================
         SECTION HEADER
    ====================================================== -->
    <div class="staff-top">

      <div>
        <span class="staff-kicker">
          {isSw ? "Ndani ya Taasisi" : "Inside the Institution"}
        </span>

        <h2 class="staff-title">
          {title}
        </h2>

        <p class="staff-subtitle">
          {subtitle}
        </p>
      </div>

      <a href={listHref} class="staff-view">
        {viewAll}
      </a>

    </div>

    <!-- =====================================================
         STAFF ACTIVITIES GRID
    ====================================================== -->
    <div class="staff-grid">

      {items.map((item) => (

        <article class="staff-card">

          <div class="staff-image-wrap">
            <img
              src={item.img}
              alt={item.title}
              class="staff-image"
            />
          </div>

          <div class="staff-body">

            <h3 class="staff-head">
              {item.title}
            </h3>

            <p class="staff-text">
              {item.text}
            </p>

          </div>

        </article>

      ))}

    </div>

  </div>
</section>

<style>

/* =====================================================
   STAFF SECTION
===================================================== */
.staff-section{
  padding:42px 0 38px;
  background:#ffffff;
}

/* =====================================================
   SECTION HEADER
===================================================== */
.staff-top{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:22px;
  margin-bottom:24px;
}

.staff-kicker{
  display:inline-flex;
  margin-bottom:8px;
  color:#f6a313;
  font-size:12px;
  font-weight:900;
  letter-spacing:2px;
  text-transform:uppercase;
}

.staff-title{
  font-size:32px;
  font-weight:900;
  color:#082b55;
  margin:0;
  line-height:1.2;
}

.staff-subtitle{
  margin:10px 0 0;
  max-width:700px;
  color:#5f6b7a;
  font-size:15px;
  line-height:1.7;
}

.staff-view{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  background:#082b55;
  color:#ffffff;
  padding:10px 18px;
  border-radius:999px;
  font-weight:900;
  font-size:13px;
  text-decoration:none;
}

.staff-view:hover{
  background:#f6a313;
}

/* =====================================================
   STAFF GRID
===================================================== */
.staff-grid{
  display:grid;
  grid-template-columns:repeat(3, minmax(0,1fr));
  gap:20px;
}

/* =====================================================
   STAFF CARD
===================================================== */
.staff-card{
  background:#ffffff;
  border-radius:22px;
  overflow:hidden;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
}

.staff-image-wrap{
  overflow:hidden;
}

.staff-image{
  width:100%;
  height:210px;
  object-fit:cover;
  display:block;
  transition:.25s ease;
}

.staff-card:hover .staff-image{
  transform:scale(1.04);
}

.staff-body{
  padding:20px;
}

.staff-head{
  font-size:20px;
  font-weight:900;
  margin:0 0 10px;
  color:#082b55;
  line-height:1.3;
}

.staff-text{
  margin:0;
  font-size:14px;
  color:#5f6b7a;
  line-height:1.7;
}

/* =====================================================
   RESPONSIVE DESIGN
===================================================== */
@media(max-width:1000px){

  .staff-grid{
    grid-template-columns:repeat(2, minmax(0,1fr));
  }

}

@media(max-width:700px){

  .staff-section{
    padding:34px 0 30px;
  }

  .staff-top{
    flex-direction:column;
  }

  .staff-view{
    width:100%;
  }

  .staff-title{
    font-size:26px;
  }

  .staff-grid{
    grid-template-columns:1fr;
  }

  .staff-image{
    height:190px;
  }

}
</style>