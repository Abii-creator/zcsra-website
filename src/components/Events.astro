---
const { lang = "en" } = Astro.props;

// =====================================================
// LANGUAGE CHECK
// Determines whether current page is Swahili or English
// =====================================================
const isSw = lang === "sw";

// =====================================================
// SECTION TEXT
// Changes section title and subtitle by language
// =====================================================
const title = isSw ? "Matukio ya Hivi Karibuni" : "Recent Events";

const subtitle = isSw
  ? "Angalia shughuli, mikutano, warsha na matukio rasmi yanayohusiana na huduma za ZCSRA."
  : "View official activities, meetings, workshops and events related to ZCSRA services.";

const readMore = isSw ? "Soma Zaidi" : "Read More";
const viewAll = isSw ? "Tazama Yote" : "View All";

const listHref = isSw ? "/sw/events/" : "/en/events/";

// =====================================================
// RECENT EVENTS DATA
// Uses local event images from public/images/events/
// =====================================================
const items = isSw
  ? [
      {
        title: "Semina ya Usajili wa Kuzaliwa",
        date: "15 Machi 2024",
        text: "Semina kwa wadau kuhusu umuhimu wa usajili wa kuzaliwa na upatikanaji wa vyeti rasmi.",
        img: "/images/events/01.jpg"
      },
      {
        title: "Warsha ya Mafunzo ya Mfumo",
        date: "3 Aprili 2024",
        text: "Warsha kwa watumishi kuhusu matumizi ya mfumo wa usajili wa matukio ya kijamii.",
        img: "/images/events/03.jpg"
      },
      {
        title: "Mkutano wa Wadau",
        date: "20 Mei 2024",
        text: "Mkutano maalum wa wadau kujadili maboresho ya utoaji wa huduma na upatikanaji wa taarifa.",
        img: "/images/events/07.jpg"
      }
    ]
  : [
      {
        title: "Birth Registration Seminar",
        date: "15 March 2024",
        text: "A seminar for stakeholders on the importance of birth registration and access to official certificates.",
        img: "/images/events/01.jpg"
      },
      {
        title: "System Training Workshop",
        date: "3 April 2024",
        text: "A workshop for officers on the use of the civil registration system and service processes.",
        img: "/images/events/03.jpg"
      },
      {
        title: "Stakeholders Meeting",
        date: "20 May 2024",
        text: "A special stakeholders meeting to discuss service delivery improvements and public access to information.",
        img: "/images/events/07.jpg"
      }
    ];
---

<section class="events-section">
  <div class="container">

    <!-- =====================================================
         SECTION HEADER
    ====================================================== -->
    <div class="events-top">

      <div>
        <span class="events-kicker">
          {isSw ? "Shughuli za Taasisi" : "Institutional Activities"}
        </span>

        <h2 class="events-title">
          {title}
        </h2>

        <p class="events-subtitle">
          {subtitle}
        </p>
      </div>

      <a href={listHref} class="events-view-all">
        {viewAll}
      </a>

    </div>

    <!-- =====================================================
         EVENTS GRID
    ====================================================== -->
    <div class="events-grid">

      {items.map((item) => (

        <article class="event-card">

          <div class="event-image-wrap">
            <img
              src={item.img}
              alt={item.title}
              class="event-image"
              loading="lazy"
            />

            <span class="event-date">
              {item.date}
            </span>
          </div>

          <div class="event-body">

            <h3 class="event-head">
              {item.title}
            </h3>

            <p class="event-text">
              {item.text}
            </p>

            <a href={listHref} class="event-btn">
              {readMore}
            </a>

          </div>

        </article>

      ))}

    </div>

  </div>
</section>

<style>

/* =====================================================
   EVENTS SECTION
===================================================== */
.events-section{
  padding:42px 0 36px;
  background:#f3f4f6;
}

/* =====================================================
   SECTION HEADER
===================================================== */
.events-top{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:22px;
  margin-bottom:24px;
}

.events-kicker{
  display:inline-flex;
  margin-bottom:8px;
  color:#f6a313;
  font-size:12px;
  font-weight:900;
  letter-spacing:2px;
  text-transform:uppercase;
}

.events-title{
  margin:0;
  font-size:32px;
  font-weight:900;
  color:#082b55;
  line-height:1.2;
}

.events-subtitle{
  margin:10px 0 0;
  max-width:680px;
  font-size:15px;
  color:#5f6b7a;
  line-height:1.7;
}

.events-view-all{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  padding:10px 18px;
  border-radius:999px;
  background:#082b55;
  color:#ffffff;
  font-size:13px;
  font-weight:900;
  text-decoration:none;
}

.events-view-all:hover{
  background:#f6a313;
}

/* =====================================================
   EVENTS GRID
===================================================== */
.events-grid{
  display:grid;
  grid-template-columns:repeat(3, minmax(0, 1fr));
  gap:20px;
}

/* =====================================================
   EVENT CARD
===================================================== */
.event-card{
  background:#ffffff;
  border-radius:22px;
  overflow:hidden;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
}

.event-image-wrap{
  position:relative;
  overflow:hidden;
  background:#e8edf3;
}

.event-image{
  width:100%;
  height:220px;
  object-fit:cover;
  display:block;
  transition:.25s ease;
}

.event-card:hover .event-image{
  transform:scale(1.04);
}

.event-date{
  position:absolute;
  left:16px;
  bottom:16px;
  display:inline-flex;
  padding:8px 12px;
  border-radius:999px;
  background:rgba(8,43,85,.92);
  color:#ffffff;
  font-size:12px;
  font-weight:900;
}

.event-body{
  padding:20px;
}

.event-head{
  margin:0 0 10px;
  font-size:21px;
  line-height:1.3;
  color:#082b55;
  font-weight:900;
}

.event-text{
  margin:0 0 18px;
  font-size:14px;
  line-height:1.75;
  color:#5f6b7a;
}

.event-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:10px 15px;
  border-radius:999px;
  background:#f6a313;
  color:#ffffff;
  font-size:13px;
  font-weight:900;
  text-decoration:none;
}

.event-btn:hover{
  background:#e3950f;
}

/* =====================================================
   RESPONSIVE DESIGN
===================================================== */
@media (max-width:1000px){

  .events-grid{
    grid-template-columns:repeat(2, minmax(0, 1fr));
  }

}

@media (max-width:700px){

  .events-section{
    padding:34px 0 30px;
  }

  .events-top{
    flex-direction:column;
  }

  .events-view-all{
    width:100%;
  }

  .events-title{
    font-size:26px;
  }

  .events-grid{
    grid-template-columns:1fr;
  }

  .event-head{
    font-size:19px;
  }

  .event-image{
    height:190px;
  }

}

</style>