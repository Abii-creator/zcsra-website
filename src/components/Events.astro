---
const { lang = "sw" } = Astro.props;

const isSw = lang === "sw";

const title = isSw ? "Matukio ya Hivi Karibuni" : "Recent Events";
const readMore = isSw ? "Soma Zaidi" : "Read More";
const viewAll = isSw ? "Tazama Matukio Yote" : "View All Events";
const listHref = isSw ? "/sw/events" : "/en/events";

const items = isSw
  ? [
      {
        title: "Semina ya Usajili wa Kuzaliwa",
        date: "15 Machi 2024",
        text: "Semina kwa wadau kuhusu umuhimu wa usajili wa kuzaliwa na upatikanaji wa vyeti rasmi.",
        img: "https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=1200&q=80"
      },
      {
        title: "Warsha ya Mafunzo ya Mfumo",
        date: "3 Aprili 2024",
        text: "Warsha kwa watumishi kuhusu matumizi ya mfumo wa usajili wa matukio ya kijamii.",
        img: "https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80"
      },
      {
        title: "Mkutano wa Wadau",
        date: "20 Mei 2024",
        text: "Mkutano maalum wa wadau kujadili maboresho ya utoaji wa huduma na upatikanaji wa taarifa.",
        img: "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80"
      }
    ]
  : [
      {
        title: "Birth Registration Seminar",
        date: "15 March 2024",
        text: "A seminar for stakeholders on the importance of birth registration and access to official certificates.",
        img: "https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=1200&q=80"
      },
      {
        title: "System Training Workshop",
        date: "3 April 2024",
        text: "A workshop for officers on the use of the civil registration system and service processes.",
        img: "https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80"
      },
      {
        title: "Stakeholders Meeting",
        date: "20 May 2024",
        text: "A special stakeholders meeting to discuss service delivery improvements and public access to information.",
        img: "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80"
      }
    ];
---

<section class="events-section">
  <div class="container">

    <div class="events-top">
      <h2 class="events-title">{title}</h2>

      <a href={listHref} class="events-view-all">
        {viewAll}
      </a>
    </div>

    <div class="events-grid">
      {items.map((item) => (
        <article class="event-card">
          <img
            src={item.img}
            alt={item.title}
            class="event-image"
          />

          <div class="event-body">
            <div class="event-date">{item.date}</div>

            <h3 class="event-head">{item.title}</h3>

            <p class="event-text">{item.text}</p>

            <a href={listHref} class="event-btn">
              {readMore}
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
.events-section{
  padding:28px 0 22px 0;
}

.events-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:20px;
  flex-wrap:wrap;
}

.events-title{
  margin:0;
  font-size:28px;
  font-weight:900;
  color:#1e3a5f;
}

.events-view-all{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:10px 14px;
  border-radius:10px;
  background:#1e3a5f;
  color:#ffffff;
  font-size:13px;
  font-weight:800;
  text-decoration:none;
}

.events-grid{
  display:grid;
  grid-template-columns:repeat(3, minmax(0, 1fr));
  gap:20px;
}

.event-card{
  background:#ffffff;
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
}

.event-image{
  width:100%;
  height:220px;
  object-fit:cover;
  display:block;
}

.event-body{
  padding:18px;
}

.event-date{
  font-size:13px;
  color:#7a8594;
  margin-bottom:10px;
  font-weight:600;
}

.event-head{
  margin:0 0 10px 0;
  font-size:22px;
  line-height:1.3;
  color:#1e3a5f;
  font-weight:900;
}

.event-text{
  margin:0 0 16px 0;
  font-size:15px;
  line-height:1.7;
  color:#5f6b7a;
}

.event-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:10px 14px;
  border-radius:10px;
  background:#f6a313;
  color:#ffffff;
  font-size:13px;
  font-weight:800;
  text-decoration:none;
}

.event-btn:hover{
  background:#e3950f;
}

@media (max-width:1000px){
  .events-grid{
    grid-template-columns:repeat(2, minmax(0, 1fr));
  }
}

@media (max-width:640px){
  .events-grid{
    grid-template-columns:1fr;
  }

  .events-title{
    font-size:22px;
  }

  .event-head{
    font-size:19px;
  }

  .events-view-all{
    width:100%;
  }

  .event-image{
    height:190px;
  }
}
</style>