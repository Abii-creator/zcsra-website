---
const { lang = "sw" } = Astro.props;

const isSw = lang === "sw";

const title = isSw
  ? "Huduma Bora za Usajili kwa Wananchi"
  : "Better Registration Services for Citizens";

const subtitle = isSw
  ? "Karibu katika tovuti rasmi ya Wakala wa Usajili wa Matukio ya Kijamii Zanzibar (ZCSRA). Pata huduma, matangazo na taarifa muhimu kwa urahisi."
  : "Welcome to the official website of the Zanzibar Civil Status Registration Agency (ZCSRA). Access registration services, announcements and important information easily.";

const btnServices = isSw ? "Huduma Zetu" : "Our Services";
const btnAnnouncements = isSw ? "Matangazo" : "Announcements";

const servicesLink = isSw ? "/sw/services/" : "/en/services/";
const announcementsLink = isSw ? "/sw/announcements/" : "/en/announcements/";
---

<section class="hero-section">
  <div class="container">

    <div class="hero-grid">

      <!-- =====================================================
           LEFT HERO BLUE PANEL
      ====================================================== -->
      <div class="hero-panel">

        <div class="hero-content">

          <span class="hero-badge">
            {isSw ? "Tovuti Rasmi ya ZCSRA" : "Official ZCSRA Portal"}
          </span>

          <h1>{title}</h1>

          <p>{subtitle}</p>

          <div class="hero-buttons">
            <a href={servicesLink} class="btn-primary">
              {btnServices}
            </a>

            <a href={announcementsLink} class="btn-secondary">
              {btnAnnouncements}
            </a>
          </div>

        </div>

        <div class="hero-service-card">

          <div class="hero-check">✓</div>

          <h2>
            {isSw ? "Huduma Muhimu" : "Key Services"}
          </h2>

          <ul>
            <li>{isSw ? "Usajili wa kuzaliwa" : "Birth registration"}</li>
            <li>{isSw ? "Usajili wa vifo" : "Death registration"}</li>
            <li>{isSw ? "Usajili wa ndoa" : "Marriage registration"}</li>
            <li>{isSw ? "Taarifa na matangazo" : "Information and announcements"}</li>
          </ul>

        </div>

      </div>

      <!-- =====================================================
           RIGHT VIDEO / FEATURE PANEL
      ====================================================== -->
      <div class="hero-video-card">

        <div class="video-image">
          <img
            src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80"
            alt="ZCSRA Office"
          />

          <button class="play-btn" type="button">
            ▶
          </button>
        </div>

        <div class="video-caption">
          {isSw ? "Tazama video ya utangulizi wa ZCSRA" : "Watch ZCSRA introductory video"}
        </div>

      </div>

    </div>

  </div>
</section>

<style>
.hero-section{
  background:#f3f4f6;
  padding:18px 0 22px;
}

.hero-grid{
  display:grid;
  grid-template-columns:1.35fr .75fr;
  gap:18px;
  align-items:stretch;
}

.hero-panel{
  background:
    radial-gradient(circle at top right,rgba(246,163,19,.16),transparent 28%),
    linear-gradient(135deg,#082b55,#153459);
  border-radius:24px;
  padding:34px 28px;
  display:grid;
  grid-template-columns:minmax(0,1fr) 300px;
  gap:28px;
  align-items:center;
  color:#ffffff;
  min-height:320px;
}

.hero-badge{
  display:inline-flex;
  padding:8px 14px;
  border-radius:999px;
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.18);
  font-size:13px;
  font-weight:900;
  margin-bottom:18px;
}

.hero-content h1{
  margin:0 0 16px;
  font-size:38px;
  line-height:1.15;
  font-weight:900;
  max-width:620px;
}

.hero-content p{
  margin:0 0 22px;
  color:#e6eef7;
  font-size:15px;
  line-height:1.8;
  max-width:680px;
}

.hero-buttons{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

.btn-primary,
.btn-secondary{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:13px 24px;
  border-radius:12px;
  font-size:14px;
  font-weight:900;
  text-decoration:none;
}

.btn-primary{
  background:#f6a313;
  color:#ffffff;
}

.btn-secondary{
  background:#ffffff;
  color:#082b55;
}

.hero-service-card{
  background:#ffffff;
  color:#082b55;
  border-radius:22px;
  padding:24px;
  box-shadow:0 18px 36px rgba(0,0,0,.18);
}

.hero-check{
  width:48px;
  height:48px;
  border-radius:14px;
  background:#f6a313;
  color:#ffffff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:28px;
  font-weight:900;
  margin-bottom:18px;
}

.hero-service-card h2{
  margin:0 0 14px;
  font-size:23px;
  font-weight:900;
}

.hero-service-card ul{
  list-style:none;
  padding:0;
  margin:0;
}

.hero-service-card li{
  position:relative;
  padding:10px 0 10px 22px;
  border-bottom:1px solid #e8edf3;
  color:#334155;
  font-size:14px;
  font-weight:800;
}

.hero-service-card li:last-child{
  border-bottom:0;
}

.hero-service-card li::before{
  content:"";
  position:absolute;
  left:0;
  top:17px;
  width:8px;
  height:8px;
  border-radius:999px;
  background:#f6a313;
}

.hero-video-card{
  background:#ffffff;
  border-radius:24px;
  overflow:hidden;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
  min-height:320px;
  display:flex;
  flex-direction:column;
}

.video-image{
  position:relative;
  flex:1;
  min-height:250px;
}

.video-image img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.play-btn{
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  width:76px;
  height:76px;
  border-radius:999px;
  border:none;
  background:#082b55;
  color:#ffffff;
  font-size:28px;
  cursor:pointer;
}

.video-caption{
  background:#082b55;
  color:#ffffff;
  padding:15px 18px;
  text-align:center;
  font-size:14px;
  font-weight:900;
}

@media (max-width:1100px){
  .hero-grid,
  .hero-panel{
    grid-template-columns:1fr;
  }
}

@media (max-width:640px){
  .hero-panel{
    padding:26px 20px;
  }

  .hero-content h1{
    font-size:30px;
  }

  .hero-service-card{
    padding:20px;
  }

  .btn-primary,
  .btn-secondary{
    width:100%;
  }
}
</style>