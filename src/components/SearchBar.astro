---
const { lang = "sw" } = Astro.props;

const placeholder =
  lang === "sw"
    ? "Tafuta huduma, matangazo au matukio..."
    : "Search services, announcements or events...";

const buttonText =
  lang === "sw"
    ? "Tafuta"
    : "Search";
---

<section class="search-section">

  <div class="container">

    <div class="search-box">

      <div class="search-input-wrap">

        <span class="search-icon">
          🔍
        </span>

        <input
          type="text"
          placeholder={placeholder}
          class="search-input"
        />

      </div>

      <button class="search-btn">
        {buttonText}
      </button>

    </div>

  </div>

</section>

<style>

/* =====================================================
   SEARCH SECTION
===================================================== */
.search-section{
  background:#f3f4f6;
  padding:14px 0 20px;
}

/* =====================================================
   SEARCH BOX
===================================================== */
.search-box{
  background:#ffffff;
  border-radius:20px;
  padding:14px;
  display:flex;
  align-items:center;
  gap:12px;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
}

/* =====================================================
   INPUT WRAPPER
===================================================== */
.search-input-wrap{
  flex:1;
  display:flex;
  align-items:center;
  gap:12px;
  border:1px solid #dde4ec;
  border-radius:14px;
  padding:0 16px;
  background:#ffffff;
}

.search-icon{
  font-size:18px;
  flex-shrink:0;
}

.search-input{
  width:100%;
  height:52px;
  border:none;
  outline:none;
  background:transparent;
  color:#1e3a5f;
  font-size:15px;
}

.search-input::placeholder{
  color:#8a94a6;
}

/* =====================================================
   BUTTON
===================================================== */
.search-btn{
  height:52px;
  border:none;
  padding:0 24px;
  border-radius:14px;
  background:#f6a313;
  color:#ffffff;
  font-size:14px;
  font-weight:800;
  cursor:pointer;
  transition:.25s ease;
}

.search-btn:hover{
  background:#e49710;
}

/* =====================================================
   RESPONSIVE
===================================================== */
@media (max-width:640px){

  .search-box{
    flex-direction:column;
    align-items:stretch;
  }

  .search-btn{
    width:100%;
  }

}

</style>