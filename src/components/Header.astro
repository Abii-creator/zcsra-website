---
const { lang = "sw" } = Astro.props;

const isSw = lang === "sw";

const agencyName = isSw
  ? "WAKALA WA USAJILI WA MATUKIO YA KIJAMII ZANZIBAR"
  : "ZANZIBAR CIVIL STATUS REGISTRATION AGENCY";

const locationName = "ZANZIBAR";

const home = isSw ? "/sw" : "/en";
const about = isSw ? "/sw/about" : "/en/about";
const services = isSw ? "/sw/services" : "/en/services";
const announcements = isSw ? "/sw/announcements" : "/en/announcements";
const events = isSw ? "/sw/events" : "/en/events";
const contact = isSw ? "/sw/contact" : "/en/contact";

const switchHref = isSw ? "/en" : "/sw";
const switchLabel = isSw ? "English" : "Kiswahili";
---

<header class="header">
  <div class="container header-inner">

    <div class="brand">
      <div class="logo-box">ZCSRA</div>

      <div class="brand-text">
        <div class="agency">{agencyName}</div>
        <div class="location">{locationName}</div>
      </div>
    </div>

    <nav class="nav">

      <a href={home}>
        {isSw ? "Mwanzo" : "Home"}
      </a>

      <a href={about}>
        {isSw ? "Kuhusu Sisi" : "About Us"}
      </a>

      <a href={services}>
        {isSw ? "Huduma" : "Services"}
      </a>

      <a href={announcements}>
        {isSw ? "Matangazo" : "Announcements"}
      </a>

      <a href={events}>
        {isSw ? "Matukio" : "Events"}
      </a>

      <a href={contact}>
        {isSw ? "Mawasiliano" : "Contact"}
      </a>

      <a href={switchHref} class="lang-btn">
        {switchLabel}
      </a>

    </nav>

  </div>
</header>

<style>

.header{
  background:#ffffff;
  border-bottom:1px solid #e6e8ec;
}

.header-inner{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:14px 0;
}

.brand{
  display:flex;
  align-items:center;
  gap:14px;
}

.logo-box{
  width:60px;
  height:60px;
  border-radius:12px;
  background:linear-gradient(135deg,#f6a313,#2f6b3d);
  display:flex;
  align-items:center;
  justify-content:center;
  color:#ffffff;
  font-weight:900;
  font-size:16px;
}

.brand-text{
  display:flex;
  flex-direction:column;
}

.agency{
  font-size:13px;
  font-weight:800;
  color:#1e3a5f;
  line-height:1.2;
}

.location{
  font-size:12px;
  color:#5f6b7a;
  font-weight:600;
}

.nav{
  display:flex;
  align-items:center;
  gap:18px;
}

.nav a{
  text-decoration:none;
  color:#1e3a5f;
  font-weight:700;
  font-size:14px;
}

.nav a:hover{
  color:#f6a313;
}

.lang-btn{
  background:#1e3a5f;
  color:#ffffff !important;
  padding:8px 16px;
  border-radius:999px;
  font-size:13px;
}

@media (max-width:900px){

.header-inner{
  flex-direction:column;
  gap:12px;
}

.nav{
  flex-wrap:wrap;
  justify-content:center;
}

}

</style>