---
const { lang = "sw" } = Astro.props;

const isSw = lang === "sw";

const title = isSw ? "Matangazo" : "Announcements";
const readMore = isSw ? "Soma" : "Read";
const viewAll = isSw ? "Yote" : "All";
const listHref = isSw ? "/sw/announcements/" : "/en/announcements/";

const allItems = isSw
  ? [
      {
        title: "Mwongozo Mpya wa Usajili wa Vifo",
        date: "22 Februari 2024",
        text: "Mwongozo mpya wa usajili wa vifo umetolewa ili kuboresha huduma."
      },
      {
        title: "Kampeni ya Uhamasishaji Kuzinduliwa",
        date: "24 Januari 2024",
        text: "Kampeni ya kuhamasisha usajili wa matukio ya kijamii imeanza."
      },
      {
        title: "Huduma Mpya za Mtandao",
        date: "19 Januari 2024",
        text: "Baadhi ya huduma sasa zinapatikana kupitia mfumo wa mtandao."
      }
    ]
  : [
      {
        title: "New Death Registration Guidelines",
        date: "22 February 2024",
        text: "New death registration guidelines have been released to improve services."
      },
      {
        title: "Public Awareness Campaign",
        date: "24 January 2024",
        text: "A public campaign has been launched to promote civil event registration."
      },
      {
        title: "New Online Services",
        date: "19 January 2024",
        text: "Selected registration services can now be accessed through the online system."
      }
    ];

const items = allItems.slice(0, 2);
---

<section class="ann-section">

  <div class="ann-shell">

    <!-- =====================================================
         SECTION HEADER
    ====================================================== -->
    <div class="ann-top">

      <div class="ann-heading-box">

        <span class="ann-kicker">
          {isSw ? "Taarifa Rasmi" : "Official Updates"}
        </span>

        <h2 class="ann-title">
          {title}
        </h2>

      </div>

      <a href={listHref} class="ann-view-all">
        {viewAll}
      </a>

    </div>

    <!-- =====================================================
         ANNOUNCEMENT LIST
    ====================================================== -->
    <div class="ann-list">

      {items.map((item) => (
        <article class="ann-card">

          <div class="ann-date">
            {item.date}
          </div>

          <h3 class="ann-head">
            {item.title}
          </h3>

          <p class="ann-text">
            {item.text}
          </p>

          <a href={listHref} class="ann-btn">
            {readMore}
          </a>

        </article>
      ))}

    </div>

  </div>

</section>

<style>

/* =====================================================
   ANNOUNCEMENT SECTION
===================================================== */
.ann-section{
  width:100%;
  min-width:0;
}

/* =====================================================
   ANNOUNCEMENT SHELL
===================================================== */
.ann-shell{
  background:#ffffff;
  border-radius:24px;
  padding:24px;
  box-shadow:0 10px 24px rgba(0,0,0,.05);
  border:1px solid #e8edf3;
  width:100%;
  min-width:0;
  height:100%;
  overflow:visible;
}

/* =====================================================
   SECTION HEADER
===================================================== */
.ann-top{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  margin-bottom:18px;
  min-width:0;
}

.ann-heading-box{
  min-width:0;
  flex:1 1 auto;
}

.ann-kicker{
  display:block;
  margin-bottom:6px;
  color:#f6a313;
  font-size:10px;
  font-weight:900;
  letter-spacing:1.2px;
  text-transform:uppercase;
  white-space:normal;
  line-height:1.3;
}

.ann-title{
  margin:0;
  font-size:25px;
  font-weight:900;
  color:#082b55;
  line-height:1.15;
  white-space:normal;
}

.ann-view-all{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  padding:9px 14px;
  border-radius:999px;
  background:#082b55;
  color:#ffffff;
  font-size:12px;
  font-weight:900;
  text-decoration:none;
  white-space:nowrap;
}

.ann-view-all:hover{
  background:#f6a313;
}

/* =====================================================
   ANNOUNCEMENT LIST
===================================================== */
.ann-list{
  display:grid;
  gap:14px;
}

/* =====================================================
   ANNOUNCEMENT CARD
===================================================== */
.ann-card{
  position:relative;
  background:#f8f9fb;
  border-radius:18px;
  padding:18px 18px 18px 20px;
  min-width:0;
  border:1px solid #edf1f5;
}

.ann-card::before{
  content:"";
  position:absolute;
  left:0;
  top:18px;
  bottom:18px;
  width:4px;
  border-radius:999px;
  background:#f6a313;
}

.ann-date{
  font-size:12px;
  color:#7a8594;
  margin-bottom:8px;
  font-weight:800;
}

.ann-head{
  margin:0 0 9px;
  font-size:17px;
  line-height:1.28;
  color:#082b55;
  font-weight:900;
  word-break:normal;
  overflow-wrap:break-word;
}

.ann-text{
  margin:0 0 12px;
  font-size:13px;
  line-height:1.6;
  color:#5f6b7a;
}

.ann-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:8px 13px;
  border-radius:999px;
  background:#f6a313;
  color:#ffffff;
  font-size:12px;
  font-weight:900;
  text-decoration:none;
}

.ann-btn:hover{
  background:#e3950f;
}

/* =====================================================
   RESPONSIVE DESIGN
===================================================== */
@media (max-width:700px){

  .ann-shell{
    padding:20px 18px;
  }

  .ann-top{
    flex-direction:column;
    gap:10px;
  }

  .ann-view-all{
    width:100%;
  }

  .ann-title{
    font-size:22px;
  }

}
</style>